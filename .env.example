# Copy this file to .env and set an approved absolute directory outside the project.
PREBI_DATA_ROOT="${HOME}/prebi-protected-data"

# Replace with an approved API key in your local .env; never commit real credentials.
GOOGLE_API_KEY="your-google-api-key-here"
# GEMINI_API_KEY is also accepted by the generation notebook.

# Optional LangSmith tracing configuration. Keep tracing disabled unless the
# project and its data-retention policy are approved for reflection data.
LANGSMITH_API_KEY="your-langsmith-api-key-here"
LANGSMITH_PROJECT="prebi-reflection-assessment"
LANGSMITH_ENDPOINT="https://eu.api.smith.langchain.com"
LANGSMITH_TRACING="false"
