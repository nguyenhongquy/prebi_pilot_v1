{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prebi Assessment and Feedback Dataset Bundle",
  "description": "Draft normalized dataset contract. Contains protected text, annotation records, model outputs, and blinded human ratings. Keep the bundle in approved protected storage. JSON Schema validates record shapes; composite keys, foreign keys, condition-dependent invariants, and split-group constraints are described here and must also be enforced by the dataset builder.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "status",
    "sources",
    "documents",
    "segments",
    "gold_segment_annotations",
    "gold_analysis_bundles",
    "expert_reference_assessments",
    "feedback_implied_scores",
    "human_feedback",
    "generation_runs",
    "rating_packets",
    "ratings",
    "feedback_span_comments",
    "split_assignments"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "dataset_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "development", "frozen"] },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "documents": {
      "type": "array",
      "items": { "$ref": "#/$defs/document" }
    },
    "segments": {
      "type": "array",
      "items": { "$ref": "#/$defs/segment" }
    },
    "gold_segment_annotations": {
      "type": "array",
      "items": { "$ref": "#/$defs/goldSegmentAnnotation" }
    },
    "gold_analysis_bundles": {
      "type": "array",
      "items": { "$ref": "#/$defs/goldAnalysisBundle" }
    },
    "expert_reference_assessments": {
      "type": "array",
      "items": { "$ref": "#/$defs/expertReferenceAssessment" }
    },
    "feedback_implied_scores": {
      "type": "array",
      "items": { "$ref": "#/$defs/feedbackImpliedScore" }
    },
    "human_feedback": {
      "type": "array",
      "items": { "$ref": "#/$defs/humanFeedback" }
    },
    "generation_runs": {
      "type": "array",
      "items": { "$ref": "#/$defs/generationRun" }
    },
    "rating_packets": {
      "type": "array",
      "items": { "$ref": "#/$defs/ratingPacket" }
    },
    "ratings": {
      "type": "array",
      "items": { "$ref": "#/$defs/rating" }
    },
    "feedback_span_comments": {
      "type": "array",
      "items": { "$ref": "#/$defs/feedbackSpanComment" }
    },
    "split_assignments": {
      "type": "array",
      "items": { "$ref": "#/$defs/splitAssignment" }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1 },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 3,
      "multipleOf": 0.1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_type", "version", "sha256", "access_tier", "canonicality"],
      "properties": {
        "source_id": { "$ref": "#/$defs/identifier" },
        "source_type": {
          "enum": [
            "original_reflection",
            "segmentation",
            "gold_segment_annotation",
            "rubric",
            "human_feedback",
            "prediction",
            "generation_output",
            "expert_assessment",
            "rater_material"
          ]
        },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "access_tier": { "enum": ["restricted", "protected", "derived", "aggregate"] },
        "canonicality": { "enum": ["canonical", "derived", "candidate", "unknown"] },
        "storage_ref": {
          "type": "string",
          "description": "Optional protected-storage reference. Never expose this field in released or annotator-facing data."
        },
        "notes": { "type": "string" }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "original_text", "source_id", "segmentation_version"],
      "properties": {
        "document_id": { "$ref": "#/$defs/identifier" },
        "original_text": {
          "type": "string",
          "minLength": 1,
          "description": "Restricted source reflection, preserved independently from reconstructed segment text."
        },
        "source_id": { "$ref": "#/$defs/identifier" },
        "segmentation_version": { "type": "string", "minLength": 1 },
        "language": { "type": "string" },
        "metadata": {
          "type": "object",
          "description": "Only approved, de-identified metadata. Do not store direct identifiers here."
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "segment_id", "segment_order", "text", "source_id"],
      "properties": {
        "document_id": { "$ref": "#/$defs/identifier" },
        "segment_id": { "$ref": "#/$defs/identifier" },
        "segment_order": { "type": "integer", "minimum": 0 },
        "text": { "type": "string", "minLength": 1 },
        "source_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "componentBands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["SW", "UA", "HA"],
      "properties": {
        "SW": { "enum": ["N", "0", "1", "2", "3"] },
        "UA": { "enum": ["N", "0", "1", "2", "3"] },
        "HA": { "enum": ["N", "0", "1", "2", "3"] }
      }
    },
    "goldSegmentAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotation_id", "candidate_id", "document_id", "segment_id", "source_id", "annotator_id", "scope", "component_bands", "resolution_status"],
      "properties": {
        "annotation_id": { "$ref": "#/$defs/identifier" },
        "candidate_id": {
          "$ref": "#/$defs/identifier",
          "description": "Identifies a candidate annotation bundle; distinct candidates for one segment remain distinct."
        },
        "document_id": { "$ref": "#/$defs/identifier" },
        "segment_id": { "$ref": "#/$defs/identifier" },
        "source_id": { "$ref": "#/$defs/identifier" },
        "annotator_id": { "$ref": "#/$defs/identifier" },
        "scope": { "enum": ["in_scope", "out_of_scope"] },
        "component_bands": { "$ref": "#/$defs/componentBands" },
        "resolution_status": { "enum": ["candidate", "adjudicated", "excluded"] },
        "adjudication_ref": { "type": ["string", "null"] },
        "rationale": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "scope": { "const": "out_of_scope" } }, "required": ["scope"] },
          "then": {
            "properties": {
              "component_bands": {
                "properties": { "SW": { "const": "N" }, "UA": { "const": "N" }, "HA": { "const": "N" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "scope": { "const": "in_scope" } }, "required": ["scope"] },
          "then": {
            "properties": {
              "component_bands": {
                "properties": {
                  "SW": { "enum": ["0", "1", "2", "3"] },
                  "UA": { "enum": ["0", "1", "2", "3"] },
                  "HA": { "enum": ["0", "1", "2", "3"] }
                }
              }
            }
          }
        }
      ]
    },
    "goldAnalysisBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gold_analysis_id", "document_id", "analysis_kind", "source_id", "candidate_id", "annotation_ids"],
      "properties": {
        "gold_analysis_id": { "$ref": "#/$defs/identifier" },
        "document_id": { "$ref": "#/$defs/identifier" },
        "analysis_kind": { "enum": ["candidate_bundle", "adjudicated"] },
        "source_id": { "$ref": "#/$defs/identifier" },
        "candidate_id": { "type": ["string", "null"] },
        "annotation_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "minItems": 1,
          "uniqueItems": true,
          "description": "References one selected segment annotation per segment; full document coverage is checked relationally."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "analysis_kind": { "const": "candidate_bundle" } }, "required": ["analysis_kind"] },
          "then": { "properties": { "candidate_id": { "$ref": "#/$defs/identifier" } } }
        },
        {
          "if": { "properties": { "analysis_kind": { "const": "adjudicated" } }, "required": ["analysis_kind"] },
          "then": { "properties": { "candidate_id": { "type": "null" } } }
        }
      ]
    },
    "dimensionScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "rationale", "evidence_segment_ids"],
      "properties": {
        "score": { "$ref": "#/$defs/score" },
        "rationale": { "type": "string", "minLength": 1 },
        "evidence_segment_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        }
      }
    },
    "expertReferenceAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_assessment_id", "document_id", "rubric_version", "annotator_id", "dimension_scores", "status", "created_at"],
      "properties": {
        "reference_assessment_id": { "$ref": "#/$defs/identifier" },
        "document_id": { "$ref": "#/$defs/identifier" },
        "rubric_version": { "type": "string", "minLength": 1 },
        "annotator_id": { "$ref": "#/$defs/identifier" },
        "dimension_scores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["SW", "UA", "HA"],
          "properties": {
            "SW": { "$ref": "#/$defs/dimensionScore" },
            "UA": { "$ref": "#/$defs/dimensionScore" },
            "HA": { "$ref": "#/$defs/dimensionScore" }
          }
        },
        "status": { "enum": ["independent", "adjudicated"] },
        "adjudication_ref": { "type": ["string", "null"] },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "feedbackImpliedScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feedback_score_id", "document_id", "human_feedback_id", "dimension_id", "evaluator_type", "evaluator_id", "score", "confidence", "rationale", "status"],
      "properties": {
        "feedback_score_id": { "$ref": "#/$defs/identifier" },
        "run_id": { "$ref": "#/$defs/identifier" },
        "document_id": { "$ref": "#/$defs/identifier" },
        "human_feedback_id": { "$ref": "#/$defs/identifier" },
        "dimension_id": { "enum": ["SW", "UA", "HA"] },
        "annotator_id": { "$ref": "#/$defs/identifier" },
        "evaluator_type": { "enum": ["human_coder", "llm_inference"] },
        "evaluator_id": { "$ref": "#/$defs/identifier" },
        "human_protocol_id": { "type": ["string", "null"] },
        "human_protocol_version": { "type": ["string", "null"] },
        "llm_prompt_id": { "type": ["string", "null"] },
        "llm_prompt_version": { "type": ["string", "null"] },
        "rendered_prompt_sha256": { "type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$" },
        "score": { "oneOf": [{ "$ref": "#/$defs/score" }, { "type": "null" }] },
        "confidence": { "enum": ["low", "medium", "high", "not_inferable"] },
        "rationale": { "type": "string", "minLength": 1 },
        "feedback_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start_character", "end_character", "quote", "status"],
            "properties": {
              "start_character": { "type": ["integer", "null"], "minimum": 0 },
              "end_character": { "type": ["integer", "null"], "minimum": 1 },
              "quote": { "type": "string", "minLength": 1 },
              "status": { "enum": ["verified", "offsets_not_provided", "invalid_offsets", "offsets_out_of_range", "offset_mismatch_quote_found_uniquely", "quote_found_multiple_times", "quote_not_found"] },
              "suggested_start_character": { "type": ["integer", "null"], "minimum": 0 },
              "suggested_end_character": { "type": ["integer", "null"], "minimum": 1 }
            }
          }
        },
        "status": { "enum": ["inferred_from_feedback", "not_inferable"] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "not_inferable" } }, "required": ["status"] },
          "then": { "properties": { "score": { "type": "null" }, "confidence": { "const": "not_inferable" } } }
        },
        {
          "if": { "properties": { "status": { "const": "inferred_from_feedback" } }, "required": ["status"] },
          "then": {
            "properties": {
              "score": { "$ref": "#/$defs/score" },
              "confidence": { "enum": ["low", "medium", "high"] }
            }
          }
        }
      ],
      "description": "Development/secondary label only; may be marked not_inferable. Record either the human protocol version or LLM prompt version used. Never substitute for an independent expert reference assessment."
    },
    "humanFeedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_feedback_id", "document_id", "feedback_text", "source_id"],
      "properties": {
        "human_feedback_id": { "$ref": "#/$defs/identifier" },
        "document_id": { "$ref": "#/$defs/identifier" },
        "feedback_text": { "type": "string", "minLength": 1 },
        "source_id": { "$ref": "#/$defs/identifier" },
        "rubric_version": { "type": "string" },
        "author_role": { "type": "string" },
        "linked_reference_assessment_id": { "type": ["string", "null"] }
      }
    },
    "generatedAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions"],
      "properties": {
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["SW", "UA", "HA"],
          "properties": {
            "SW": { "$ref": "#/$defs/generatedDimensionAssessment" },
            "UA": { "$ref": "#/$defs/generatedDimensionAssessment" },
            "HA": { "$ref": "#/$defs/generatedDimensionAssessment" }
          }
        }
      }
    },
    "generatedDimensionAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "justification", "evidence_segment_ids"],
      "properties": {
        "score": { "$ref": "#/$defs/score" },
        "justification": { "type": "string", "minLength": 1 },
        "evidence_segment_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "feedbackPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence_segment_ids"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "evidence_segment_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true
        }
      }
    },
    "generationRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "document_id", "condition", "repetition", "model_provider", "model_name", "prompt_version", "rubric_version", "created_at", "analysis_source", "analysis_reference_id", "assessment", "feedback", "validation_status"],
      "properties": {
        "run_id": { "$ref": "#/$defs/identifier" },
        "document_id": { "$ref": "#/$defs/identifier" },
        "condition": { "enum": ["G1", "G2", "G3"] },
        "repetition": { "type": "integer", "minimum": 1 },
        "model_provider": { "type": "string", "minLength": 1 },
        "model_name": { "type": "string", "minLength": 1 },
        "model_version": { "type": ["string", "null"] },
        "prompt_version": { "type": "string", "minLength": 1 },
        "prompt_artifact_sha256": { "type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$" },
        "prompt_components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact_id", "version", "sha256"],
            "properties": {
              "artifact_id": { "$ref": "#/$defs/identifier" },
              "version": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
            }
          }
        },
        "rendered_prompt_sha256": { "type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$" },
        "rubric_artifact_sha256": { "type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$" },
        "rubric_version": { "type": "string", "minLength": 1 },
        "generation_parameters": { "type": "object" },
        "created_at": { "type": "string", "format": "date-time" },
        "analysis_source": { "enum": ["none", "predicted", "gold_candidate", "gold_adjudicated"] },
        "analysis_reference_id": {
          "type": ["string", "null"],
          "description": "G2 references a predicted-analysis artifact; G3 references a gold_analysis_id bundle."
        },
        "assessment": { "$ref": "#/$defs/generatedAssessment" },
        "feedback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strengths", "weaknesses", "suggestions"],
          "properties": {
            "strengths": { "type": "array", "items": { "$ref": "#/$defs/feedbackPoint" } },
            "weaknesses": { "type": "array", "items": { "$ref": "#/$defs/feedbackPoint" } },
            "suggestions": { "type": "array", "items": { "$ref": "#/$defs/feedbackPoint" } }
          }
        },
        "validation_status": { "enum": ["valid", "invalid", "not_checked"] },
        "validation_message": { "type": ["string", "null"] },
        "source_id": { "$ref": "#/$defs/identifier" }
      },
      "allOf": [
        {
          "if": { "properties": { "condition": { "const": "G1" } }, "required": ["condition"] },
          "then": { "properties": { "analysis_source": { "const": "none" }, "analysis_reference_id": { "type": "null" } } }
        },
        {
          "if": { "properties": { "condition": { "const": "G2" } }, "required": ["condition"] },
          "then": { "properties": { "analysis_source": { "const": "predicted" }, "analysis_reference_id": { "$ref": "#/$defs/identifier" } } }
        },
        {
          "if": { "properties": { "condition": { "const": "G3" } }, "required": ["condition"] },
          "then": {
            "properties": {
              "analysis_source": { "enum": ["gold_candidate", "gold_adjudicated"] },
              "analysis_reference_id": { "$ref": "#/$defs/identifier" }
            }
          }
        }
      ]
    },
    "ratingPacket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_id", "task", "packet_version", "protocol_id", "protocol_version", "human_protocol", "display_output_sha256", "displayed_reflection_sha256", "rubric_version", "reflection", "rubric", "condition_blinded", "displayed_context"],
      "properties": {
        "packet_id": { "$ref": "#/$defs/identifier" },
        "task": { "enum": ["assessment_quality", "feedback_quality", "feedback_implied_score"] },
        "packet_version": { "type": "string", "minLength": 1 },
        "protocol_id": { "$ref": "#/$defs/identifier" },
        "protocol_version": { "type": "string", "minLength": 1 },
        "human_protocol": { "type": "string", "minLength": 1 },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["criterion_id", "label", "description"],
            "properties": {
              "criterion_id": { "$ref": "#/$defs/identifier" },
              "label": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "anchors": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "scale": { "type": "object" },
        "score_dimensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dimension_id", "label"],
            "properties": {
              "dimension_id": { "$ref": "#/$defs/identifier" },
              "label": { "type": "string", "minLength": 1 }
            }
          }
        },
        "display_output_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "displayed_reflection_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "rubric_version": { "type": "string", "minLength": 1 },
        "human_feedback": { "type": "string", "minLength": 1 },
        "reflection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["segments"],
          "properties": {
            "segments": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["segment_id", "order", "text"],
                "properties": {
                  "segment_id": { "$ref": "#/$defs/identifier" },
                  "order": { "type": "integer", "minimum": 0 },
                  "text": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "rubric": { "type": "object" },
        "output": { "type": "object" },
        "condition_blinded": { "const": true },
        "displayed_context": {
          "type": "array",
          "items": { "enum": ["segmented_reflection", "rubric", "assessment_output", "feedback_output", "original_human_feedback"] },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": { "properties": { "task": { "const": "assessment_quality" } }, "required": ["task"] },
          "then": {
            "required": ["criteria", "scale", "output"],
            "properties": { "displayed_context": { "contains": { "const": "assessment_output" } } }
          }
        },
        {
          "if": { "properties": { "task": { "const": "feedback_quality" } }, "required": ["task"] },
          "then": {
            "required": ["criteria", "scale", "output"],
            "properties": { "displayed_context": { "contains": { "const": "feedback_output" } } }
          }
        },
        {
          "if": { "properties": { "task": { "const": "feedback_implied_score" } }, "required": ["task"] },
          "then": {
            "required": ["score_dimensions", "human_feedback"],
            "properties": { "displayed_context": { "contains": { "const": "original_human_feedback" } } }
          }
        }
      ],
      "description": "Do not include condition, model, gold labels, expert reference scores, or intermediate analysis in the annotator-facing packet. Human and LLM evaluators must reference the same immutable packet snapshot."
    },
    "criterionRating": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "score", "unable_to_judge"],
      "properties": {
        "criterion_id": { "$ref": "#/$defs/identifier" },
        "score": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
        "unable_to_judge": { "type": "boolean" },
        "comment": { "type": "string" }
      },
      "description": "Use the referenced packet scale: quality protocols 0.1.0 use 1-5; 0.2.0 and assessment 0.3.0 use 1-3. Exactly one score or unable_to_judge=true should be set; enforce the packet-specific range in the dataset builder."
    },
    "rating": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rating_id", "packet_id", "annotator_id", "evaluator_type", "criterion_ratings", "submitted_at", "adjudication_status"],
      "properties": {
        "rating_id": { "$ref": "#/$defs/identifier" },
        "packet_id": { "$ref": "#/$defs/identifier" },
        "annotator_id": { "$ref": "#/$defs/identifier" },
        "evaluator_type": { "enum": ["human", "llm_judge"] },
        "evaluator_model": { "type": ["string", "null"] },
        "human_protocol_id": { "type": ["string", "null"] },
        "human_protocol_version": { "type": ["string", "null"] },
        "llm_prompt_id": { "type": ["string", "null"] },
        "llm_prompt_version": { "type": ["string", "null"] },
        "rendered_prompt_sha256": { "type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$" },
        "criterion_ratings": { "type": "array", "items": { "$ref": "#/$defs/criterionRating" }, "minItems": 1 },
        "overall_comment": { "type": "string" },
        "submitted_at": { "type": "string", "format": "date-time" },
        "adjudication_status": { "enum": ["independent", "selected_for_adjudication", "adjudicated"] },
        "adjudicated_rating_id": { "type": ["string", "null"] }
      }
    },
    "feedbackSpanComment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["span_comment_id", "rating_id", "packet_id", "feedback_component", "feedback_item_index", "start_character", "end_character", "display_output_sha256", "comment"],
      "properties": {
        "span_comment_id": { "$ref": "#/$defs/identifier" },
        "rating_id": { "$ref": "#/$defs/identifier" },
        "packet_id": { "$ref": "#/$defs/identifier" },
        "feedback_component": { "enum": ["strengths", "weaknesses", "suggestions"] },
        "feedback_item_index": { "type": "integer", "minimum": 0 },
        "start_character": { "type": "integer", "minimum": 0 },
        "end_character": { "type": "integer", "minimum": 1 },
        "display_output_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "tags": {
          "type": "array",
          "items": { "enum": ["unsupported", "inaccurate", "vague", "actionable", "strength", "concern", "other"] },
          "uniqueItems": true
        },
        "comment": { "type": "string", "minLength": 1 },
        "linked_reflection_segment_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" },
          "uniqueItems": true,
          "description": "Source evidence links, distinct from the highlighted generated-feedback span."
        }
      },
      "description": "Character offsets refer to the exact immutable displayed feedback item; enforce start_character < end_character <= item length outside JSON Schema."
    },
    "splitAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "author_group_id", "split_role", "assignment_version"],
      "properties": {
        "document_id": { "$ref": "#/$defs/identifier" },
        "author_group_id": {
          "$ref": "#/$defs/identifier",
          "description": "Pseudonymous group key; keep any re-identification mapping separately under restricted access."
        },
        "split_role": { "enum": ["development", "confirmatory", "exploratory", "excluded"] },
        "assignment_version": { "type": "string", "minLength": 1 },
        "reason": { "type": "string" }
      },
      "description": "Documents sharing an author_group_id must not cross split roles. Document 188 is exploratory and must not be assigned confirmatory."
    }
  }
}
